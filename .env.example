# Neon pooled URL for app requests. Keep real credentials only in .env and Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct URL for Prisma migrations (same host without -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Generate a strong value for a real deployment; never commit .env.
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST=true
# Optional on a hosted server: long random secret for POST /api/cron/recurring.
# CRON_SECRET="generate-a-long-random-secret"
